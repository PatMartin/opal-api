{
  "name": "opal-api",
  "version": "1.0.0",
  "private": true,
  "description": "OPAL suite OpenAPI contracts (event, listen, say) and their validation tooling.",
  "scripts": {
    "validate": "redocly lint \"openapi/*.yaml\"",
    "lint": "spectral lint -r .spectral.yaml \"openapi/*.yaml\"",
    "lint:opal": "spectral lint -r .spectral.opal.yaml \"openapi/*.yaml\"",
    "check": "npm run validate && npm run lint && npm run lint:opal && npm run lint:look && npm run lint:think && npm run test:lint && npm run test:event141 && npm run test:think-event && npm run test:look-cli && npm run test:listen141 && npm run test:say141 && npm run test:rest-security",
    "lint:look": "spectral lint -r .spectral.opal.look.yaml openapi/opal_look.yaml",
    "test:lint": "python tests/test_lint.py",
    "test:event141": "python tests/test_event_141.py",
    "test:think-event": "python tests/test_think_event.py",
    "test:look-cli": "python tests/test_look_cli.py",
    "test:listen141": "python tests/test_listen_141.py",
    "test:say141": "python tests/test_say_141.py",
    "test:rest-security": "python tests/test_rest_security.py",
    "lint:think": "spectral lint -r .spectral.opal.think.yaml openapi/opal_think.yaml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PatMartin/opal-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PatMartin/opal-api/issues"
  },
  "homepage": "https://github.com/PatMartin/opal-api#readme",
  "devDependencies": {
    "@redocly/cli": "2.66.1",
    "@stoplight/spectral-cli": "6.17.0"
  }
}